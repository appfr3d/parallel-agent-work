{
  "name": "bg-bekks-gang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:portless": "portless run --name bg tsx server/portless-dev.ts",
    "dev:server": "tsx server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@kilden/design-tokens": "^0.0.5",
    "@kilden/designsystem": "^0.0.20",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "express": "^5.0.0",
    "lowdb": "^7.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "portless": "^0.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
